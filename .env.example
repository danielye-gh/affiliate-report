# Impact (https://integrations.impact.com)
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# advertiser | mediapartner
IMPACT_ACCOUNT_TYPE=advertiser
# Program/Campaign ID (SUBAID). Required for advertiser report export.
IMPACT_PROGRAM_ID=
# Report handle for Advanced Action Listing, e.g. mp_action_listing_fast (partner) or adv_* (advertiser)
# Set IMPACT_DEBUG=1 to also print response status lines (same as -v)
IMPACT_ACTION_REPORT_HANDLE=adv_action_listing_pm_only

# Advanced Action Listing report filters
IMPACT_REPORT_CHANNEL=Affiliate/CPA Network
IMPACT_REPORT_ACTION_STATUS=Approved,Pending,Approved/N/A (Media Source)
IMPACT_REPORT_CURRENCY=USD

# CJ (Commission Junction) — currently disabled in pipeline/CLI.
# Uncomment and restore CJ wiring in monthly_report / cli to re-enable.
# https://developers.cj.com
# CJ_API_KEY=
# Company ID (CID) from CJ dashboard → Account (advertiser or publisher)
# CJ_COMPANY_ID=
# advertiser | publisher (Petlibro brand side is usually advertiser)
# CJ_ACCOUNT_TYPE=advertiser
# Optional publisher website ID filter
# CJ_WEBSITE_ID=
# posting | event (default posting — aligns with CJ monthly posting reports)
# CJ_DATE_FIELD=posting
# Optional comma-separated action status filter, e.g. closed,pending
# CJ_ACTION_STATUS=

# Awin (https://developer.awin.com)
AWIN_API_TOKEN=
# Advertiser account IDs (from `affiliate-report awin list-accounts`)
AWIN_ADVERTISER_ID_DE=
AWIN_ADVERTISER_ID_UK=
# Legacy aliases (same IDs as above)
# AWIN_PUBLISHER_ID_DE=
# AWIN_PUBLISHER_ID_UK=

# Shopify Admin API — US / DE / UK stores
SHOPIFY_SHOP_US=
SHOPIFY_ACCESS_TOKEN_US=
SHOPIFY_SHOP_DE=
SHOPIFY_ACCESS_TOKEN_DE=
SHOPIFY_SHOP_UK=
SHOPIFY_ACCESS_TOKEN_UK=
SHOPIFY_API_VERSION=2025-01

# UTM source filters (source only)
# SHOPIFY_CJ_UTM_SOURCE=cj  # CJ disabled
SHOPIFY_IMPACT_UTM_SOURCE=impact
SHOPIFY_AWIN_UTM_SOURCE=awin

# Feishu (optional) — sync exclusive-code approval rules into local CSV
# Offline users can skip these and edit data/config/exclusive_codes.csv directly.
# Create a Feishu custom app, enable sheets:spreadsheet:readonly (or sheets:spreadsheet),
# then share the spreadsheet with that app ("添加文档应用").
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Spreadsheet URL (.../sheets/shtxxx) or raw token
FEISHU_EXCLUSIVE_CODES_URL=
# FEISHU_EXCLUSIVE_CODES_TOKEN=
# Optional sheet id; defaults to the first sheet
# FEISHU_EXCLUSIVE_CODES_SHEET_ID=

# 在线更新（GUI「在线更新」按钮 / report.bat update）
# GitHub public 仓库，格式 用户名/仓库名；不填则使用 updater.py 内置默认值或 git remote
# UPDATE_REPO=your-name/affiliate-report
# UPDATE_BRANCH=main
